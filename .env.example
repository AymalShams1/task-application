# Copy to .env and edit as needed. Compose picks .env up automatically.

# Published UI image. Pin a specific tag here if you do not want latest.
FRONTEND_IMAGE=ghcr.io/aymalshams1/task-app-frontend:latest

# Host ports. Change these if 3000 or 8080 are already in use.
UI_HOST_PORT=3000
BACKEND_HOST_PORT=8080
